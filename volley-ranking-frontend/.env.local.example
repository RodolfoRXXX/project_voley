# Identidad Firebase sintética. El project ID debe coincidir con --project del Emulator Suite.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-sportexa-local.localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-sportexa-local
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-sportexa-local.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo

# Conexión exclusiva a emuladores locales.
# Para probar desde otro equipo de la LAN, reemplazar 127.0.0.1 por la IP LAN del host en ambas variables.
NEXT_PUBLIC_USE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FUNCTIONS_BASE_URL=http://127.0.0.1:5001/demo-sportexa-local/us-central1
