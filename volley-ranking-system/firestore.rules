rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAppAdmin() {
      return signedIn()
        && currentUserDoc().data.get("roles", null) == "admin";
    }

    function hasId(values, userId) {
      return values is list && userId in values;
    }

    function isGroupMemberByData(group) {
      return signedIn()
        && (hasId(group.get("memberIds", []), request.auth.uid)
          || hasId(group.get("adminIds", []), request.auth.uid)
          || group.get("ownerId", null) == request.auth.uid);
    }

    function isGroupAdminByData(group) {
      return signedIn()
        && (hasId(group.get("adminIds", []), request.auth.uid)
          || group.get("ownerId", null) == request.auth.uid);
    }

    function isGroupMemberById(groupId) {
      return signedIn()
        && groupId is string
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && isGroupMemberByData(
          get(/databases/$(database)/documents/groups/$(groupId)).data
        );
    }

    function isGroupAdminById(groupId) {
      return signedIn()
        && groupId is string
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && isGroupAdminByData(
          get(/databases/$(database)/documents/groups/$(groupId)).data
        );
    }

    function isTournamentAdminByData(tournament) {
      return signedIn()
        && (hasId(tournament.get("adminIds", []), request.auth.uid)
          || tournament.get("ownerAdminId", null) == request.auth.uid);
    }

    function isTournamentAdminById(tournamentId) {
      return signedIn()
        && tournamentId is string
        && exists(/databases/$(database)/documents/tournaments/$(tournamentId))
        && isTournamentAdminByData(
          get(/databases/$(database)/documents/tournaments/$(tournamentId)).data
        );
    }

    function isMatchGroupAdmin(matchId) {
      return signedIn()
        && matchId is string
        && exists(/databases/$(database)/documents/matches/$(matchId))
        && isGroupAdminById(
          get(/databases/$(database)/documents/matches/$(matchId)).data.groupId
        );
    }

    function isGroupAdmin() {
      return signedIn()
        && request.resource.data.adminIds is list
        && request.auth.uid in request.resource.data.adminIds;
    }

    function isExistingGroupAdmin() {
      return signedIn()
        && resource.data.adminIds is list
        && request.auth.uid in resource.data.adminIds;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAppAdmin();
      allow create, update, delete: if false;

      match /pendingAlerts/{alertId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    match /groups/{groupId} {
      allow get: if isAppAdmin() || isGroupMemberByData(resource.data);
      allow list: if isAppAdmin();
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow list: if signedIn() && request.auth.uid in resource.data.adminIds;
      allow list: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isAppAdmin() && isGroupAdmin();
      allow update: if isAppAdmin() && isExistingGroupAdmin();
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read: if isAppAdmin()
        || isGroupMemberById(resource.data.groupId);
      allow write: if false;
    }

    match /participations/{participationId} {
      allow read: if isAppAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || isMatchGroupAdmin(resource.data.matchId);
      allow write: if false;
    }

    match /teams/{teamId} {
      allow read: if isAppAdmin()
        || isGroupMemberById(resource.data.groupId);
      allow write: if false;
    }

    match /groupStats/{statId} {
      allow read: if isAppAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || isGroupAdminById(resource.data.groupId);
      allow write: if false;
    }

    match /tournaments/{tournamentId} {
      allow read: if isAppAdmin()
        || isTournamentAdminByData(resource.data);
      allow write: if false;
    }

    match /tournamentPhases/{phaseId} {
      allow read: if isAppAdmin()
        || isTournamentAdminById(resource.data.tournamentId);
      allow write: if false;
    }

    match /tournamentRegistrations/{registrationId} {
      allow read: if isAppAdmin()
        || isTournamentAdminById(resource.data.tournamentId)
        || isGroupAdminById(resource.data.groupId)
        || (signedIn() && hasId(resource.data.playerIds, request.auth.uid));
      allow update: if signedIn()
        && resource.data.groupId is string
        && exists(/databases/$(database)/documents/groups/$(resource.data.groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.adminIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "playerIds",
          "teamMembersCount",
          "expectedAmount",
          "pendingAmount",
          "paymentStatus",
          "updatedAt",
        ]);
      allow create, delete: if false;
    }

    match /tournamentTeams/{teamId} {
      allow read: if isAppAdmin()
        || isTournamentAdminById(resource.data.tournamentId)
        || isGroupAdminById(resource.data.groupId)
        || (signedIn() && hasId(resource.data.playerIds, request.auth.uid));
      allow update: if signedIn()
        && resource.data.groupId is string
        && exists(/databases/$(database)/documents/groups/$(resource.data.groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.adminIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "playerIds",
          "teamMembersCount",
          "expectedAmount",
          "pendingAmount",
          "paymentStatus",
          "updatedAt",
        ]);
      allow create, delete: if false;
    }

    match /tournamentMatches/{matchId} {
      allow read: if isAppAdmin()
        || isTournamentAdminById(resource.data.tournamentId);
      allow write: if false;
    }

    match /tournamentStandings/{standingId} {
      allow read: if isAppAdmin()
        || isTournamentAdminById(resource.data.tournamentId);
      allow write: if false;
    }

    match /tournamentAdvancementRules/{ruleId} {
      allow read: if isAppAdmin()
        || isTournamentAdminById(resource.data.tournamentId);
      allow write: if false;
    }

    match /push_subscriptions/{subscriptionId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
