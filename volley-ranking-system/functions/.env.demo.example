# Copiar como .env.<projectId>, por ejemplo .env.demo-sportexa-local.
# Habilita productores y workers de la proyección únicamente en el proyecto demo indicado al CLI.
ENABLE_DASHBOARD_TASK_PROJECTION=true

# Secreto local para firmar cursores. Debe tener al menos 32 caracteres.
# Reemplazar este placeholder por un valor sintético propio; nunca reutilizar secretos productivos.
DASHBOARD_TASK_CURSOR_SECRET=replace-with-local-secret-at-least-32-chars
